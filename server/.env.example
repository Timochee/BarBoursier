# Bar Boursier Environment Configuration
# Copy to .env.development (dev) or .env.production (Docker/production)

# ===================
# Google OAuth Configuration
# ===================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth callback URL (optional - defaults to http://localhost:PORT/api/auth/google/callback)
# Set this for production to your actual domain
# OAUTH_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ===================
# Authentication
# ===================
# Email of the superadmin user (has full access to manage admins)
SUPERADMIN_EMAIL=your-email@example.com

# JWT secret for signing tokens (generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-secure-random-string

# ===================
# Server Configuration
# ===================
# Port the server listens on
PORT=3001

# Client URL for CORS and OAuth redirects
# Development: http://localhost:5173
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Node environment (set automatically in docker-compose)
# NODE_ENV=development

# ===================
# Logging
# ===================
# Log level: debug, info, warn, error
LOG_LEVEL=info
